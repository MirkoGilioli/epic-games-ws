{
  "mcpServers": {
    "bigquery": {
      "command": "python3",
      "args": [
        "-m",
        "mcp_server_bigquery",
        "--project=${GCP_PROJECT}",
        "--dataset=epic_liveops"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}"
      }
    }
  }
}
